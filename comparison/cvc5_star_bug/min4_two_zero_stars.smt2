(set-logic HO_ALL)
(declare-const w1 Int)
(declare-const w2 Int)
(declare-const w3 Int)
(declare-const x1 Int)
(declare-const x2 Int)
(declare-const x3 Int)
(assert (and (not (= w1 x1))
  (int.star-contains (lambda ((a Int) (b Int) (c Int)) (and (and (= a 0) (= b 0)) (= c 0))) w1 w2 w3)
  (int.star-contains (lambda ((a Int) (b Int) (c Int)) (and (and (= a 0) (= b 0)) (= c 0))) x1 x2 x3)))
(check-sat)
